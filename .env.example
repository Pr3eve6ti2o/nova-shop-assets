# Nova Shop — environment configuration.
# Copy to .env and fill in the values. NEVER commit a filled .env.
# Only BOT_TOKEN is strictly required; every other integration is optional
# and the bot degrades gracefully without it.

# --- Core -------------------------------------------------------------------
BOT_TOKEN=                       # BotFather token for the shop bot
ADMINS=                          # Comma-separated Telegram user IDs of admins
CURRENCY=USD                     # Display currency code
SUPPORT_USERNAME=                # Telegram username customers contact for help
RETURNS_WINDOW_DAYS=14           # Days a customer may request a return (0 = off)
BUYER_INFO_MODE=none             # Checkout data mode: none | email | address

# --- Campaign engine (customer-lifecycle messages) --------------------------
CAMPAIGNS_ENABLED=1              # Master switch for the campaign worker
ABANDONED_CART_DELAY_MINUTES=60  # Idle time before a cart reminder
POST_PURCHASE_DELAY_HOURS=24     # Delay before the post-delivery thank-you
ONBOARDING_NUDGE_HOURS=24        # Nudge new users with no order after this

# --- Outbound webhooks + admin forum (merchant tooling) -----------------------
# SHOP_WEBHOOK_URL=              # Receives signed order.created/order.paid POSTs
# SHOP_WEBHOOK_SECRET=           # HMAC-SHA256 signing secret for webhooks
# ADMIN_FORUM_CHAT_ID=           # Forum supergroup for admin notifications
# ADMIN_TOPIC_ORDERS=            # Forum topic id for order/return alerts
# ADMIN_TOPIC_SUPPORT=           # Forum topic id for support alerts
# ADMIN_TOPIC_PAYMENTS=          # Forum topic id for payment alerts
DATABASE_PATH=data/nova_shop.db  # SQLite path (or set DATABASE_URL for Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/nova_shop

# --- Telegram payments --------------------------------------------------------
PAYMENTS_PROVIDER_TOKEN=         # Telegram Payments provider token (Stripe etc.)
MINIAPP_URL=                     # Public URL of the Mini App

# --- CryptoBot ----------------------------------------------------------------
CRYPTOBOT_TOKEN=                 # Crypto Pay API token (@CryptoBot > Crypto Pay)
# CRYPTOBOT_FEE_PERCENT=3        # Fee grossed up into invoice amounts
# CRYPTOBOT_TESTNET=0

# --- Self-custody deposit watchers --------------------------------------------
XPUB_BTC=                        # BTC extended public key for deposit derivation
XPUB_ETH=                        # ETH extended public key
XPUB_TRX=                        # TRX extended public key
TESTNET_XPUB_ETH=                # Testnet ETH xpub (test mode only)
TON_DEPOSIT_ADDRESS=             # TON deposit address
ETHERSCAN_API_KEY=               # Etherscan V2 key (ETH/Polygon/Base scanning)
# BSCSCAN_API_KEY=               # BscScan key (enables the BSC rail)

# --- Rental SaaS / control plane ------------------------------------------------NOVA_API_URL=                    # Control-plane API base URL (rental backend)
NOVA_API_KEY=                    # Control-plane API key
MANAGER_BOT_USERNAME=            # Manager bot username (rental onboarding)

# --- Payload CMS (admin panel) --------------------------------------------------
PAYLOAD_URL=                     # Payload CMS base URL
PAYLOAD_API_KEY=                 # Payload API key

# --- Webhook mode (optional; polling is the default) ------------------------------
WEBHOOK_HOST=                    # Public HTTPS host for Telegram webhooks
WEBHOOK_PATH=                    # Webhook path
WEBHOOK_SECRET_TOKEN=            # Telegram secret_token for webhook verification
PORT=8080                        # Webhook/listen port
WORKERS=1                        # Worker processes

# --- Networking -------------------------------------------------------------------
# HTTPS_PROXY=                   # Outbound proxy, if the host requires one
