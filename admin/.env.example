# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# Payload secret (REQUIRED, minimum 32 characters). The panel refuses to
# build or start with a shorter secret.
PAYLOAD_SECRET=

# Database URL for Payload's SQLite adapter, e.g.:
#   DATABASE_URL=file:./payload.db
# Leave unset to use the adapter's default local file.
DATABASE_URL=

# --- Bot internal API (optional) ---
# Enables the panel's store-credit actions (Customers credit/debit,
# gift-card create/revoke, manual orders, refund-to-credit, buyer
# write-back). Point at the bot's internal API; the secret must match the
# bot's INTERNAL_API_SECRET. Unset = those actions report
# "not configured" and the rest of the panel works normally.
NOVA_BOT_API_URL=http://127.0.0.1:8091
NOVA_BOT_API_SECRET=
