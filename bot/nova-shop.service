# Canonical systemd unit for Nova Shop Bot.
# Installed copy: /etc/systemd/system/nova-shop.service
# Re-install after edits:
#   cp ~/workspace/nova-shop/nova-shop.service /etc/systemd/system/nova-shop.service
#   systemctl daemon-reload && systemctl restart nova-shop

[Unit]
Description=Nova Shop Bot (aiogram, polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/nova-shop
# Project venv first on PATH (aiogram 2.25.2 + aiohttp>=3.9 + aiosqlite).
Environment=PATH=/home/hatch/workspace/nova-shop/.venv/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Egress proxy credentials (rotated frequently, refreshed by cron).
EnvironmentFile=-/home/hatch/workspace/nova-shop/.proxy.env
# run.sh loops forever, restarting `python app.py` on crash with backoff.
ExecStart=/home/hatch/workspace/nova-shop/run.sh
Restart=always
RestartSec=15
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=25
KillMode=control-group
StandardOutput=append:/home/hatch/workspace/nova-shop/bot.log
StandardError=append:/home/hatch/workspace/nova-shop/bot.log

[Install]
# The guest boots a minimal default.target (not multi-user.target).
WantedBy=default.target
