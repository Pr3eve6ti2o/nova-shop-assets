# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# Telegram bot token from @BotFather (REQUIRED).
BOT_TOKEN=YOUR_BOT_TOKEN

# Comma-separated Telegram user IDs with full admin rights, e.g. 123456789,987654321.
# Admins get the full permission bitmask (127) on their first /start.
ADMINS=

# Telegram Payments provider token for fiat card payments (optional).
# When unset, the "Card" payment button is hidden. Get one from @BotFather
# -> your bot -> Payments.
PAYMENTS_PROVIDER_TOKEN=

# Telegram Stars conversion: how many Stars equal 1 USD (default 60).
STARS_PER_USD=60

# ISO 4217 fiat currency code (default USD).
CURRENCY=USD

# % of a referee's first paid order credited to the referrer (default 5).
REFERRAL_PERCENT=5

# Flat delivery fee in cents (default 0 = free delivery).
DELIVERY_FEE_CENTS=0

# Webhook mode (optional). Leave unset for long polling.
WEBHOOK_HOST=
WEBHOOK_PATH=

# --- Crypto payments (all optional, free tiers) ---
# CryptoBot rail: token from @CryptoBot -> Crypto Pay -> Create App.
# Testnet: use @CryptoTestnetBot and set CRYPTOBOT_TESTNET=1.
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=0
CRYPTOBOT_FEE_PERCENT=3

# Self-custody direct deposits: paste ACCOUNT xpubs (never the seed!).
# The bot derives a fresh address per order; your seed stays offline.
XPUB_BTC=
XPUB_ETH=
XPUB_TRX=
# TON uses one static address + unique memo per order (no xpub needed).
TON_DEPOSIT_ADDRESS=

# Deposit payment window in minutes (default 45).
CRYPTO_TTL_MINUTES=45

# --- Mini App (optional) ---
# Public HTTPS URL of the hosted Mini App (see miniapp/README.md).
# Unset = classic bot only, everything keeps working.
MINIAPP_URL=

# --- Payload CMS admin panel (optional) ---
# Base URL of the Payload admin (see admin/README.md).
# Unset = no catalog sync / order push; everything keeps working.
PAYLOAD_URL=
# API key of the Payload sync user (users collection, role=admin).
# Never commit a real key here — put it in .env, not .env.example.
PAYLOAD_API_KEY=
